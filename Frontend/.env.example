# Founder's Wall — frontend environment template.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ vars are inlined at BUILD time and are visible in the browser
# bundle — never put a secret here.

# Base URL of the Founder's Wall API.
#   Local development against `python scripts/devserver.py` (or `make run`)
#   in ../backend:
NEXT_PUBLIC_API_URL=http://localhost:8000
#
#   In the shipped docker-compose, leave this EMPTY: nginx serves the API and
#   the frontend on one origin, so the browser calls /stats and /ws/wall
#   relative to the page. (compose sets the build arg to "" for you.)
# NEXT_PUBLIC_API_URL=

# GoXL parent-brand website (the header logo links here). Optional — defaults
# to https://goxl.in.
# NEXT_PUBLIC_GOXL_URL=https://goxl.in

# GoXL WhatsApp community invite. Optional — a default is baked in; set this to
# override. Empty hides the community actions.
# NEXT_PUBLIC_GOXL_WHATSAPP_URL=

# Google Analytics measurement id (e.g. G-XXXXXXXXXX). Optional — analytics
# loads only when this is set; unset means no tracking and no breakage.
# NEXT_PUBLIC_GA_ID=
